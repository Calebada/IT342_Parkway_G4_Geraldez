# Parkway Frontend Environment Configuration
# Copy this file to .env.local and update with your environment URLs

# Backend API URL
REACT_APP_API_URL=http://localhost:8080

# Google OAuth Configuration (when needed)
# REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id-here

# Production Example:
# REACT_APP_API_URL=https://api.parkway-production.com
