{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "env": {
    "REACT_APP_API_URL": "https://it342-parkway-g4-geraldez.onrender.com"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://it342-parkway-g4-geraldez.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
